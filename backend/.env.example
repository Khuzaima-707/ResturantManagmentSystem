# RMS Backend Environment Variables Template
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URI (Add your connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/restaurant_pos?retryWrites=true&w=majority

# Client URL (Allowed origins for CORS)
CLIENT_URL=http://localhost:5173

# Authentication JWT
JWT_SECRET=spicehub_pos_jwt_super_secret_key_2026_rms_auth
JWT_EXPIRES_IN=never

# Optional: Cloudinary Storage for Dish/Menu Photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
